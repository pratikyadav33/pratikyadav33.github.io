<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% if title and title != "Home" %}{{ title }} · {% endif %}{{ site.name }}</title>
    <meta name="description" content="{{ description or site.description }}" />
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body class="{% if page.url == "/" %}home{% else %}reading{% endif %} rick-site">
    <canvas id="landscape-bg" aria-hidden="true"></canvas>
    <div class="page">
      <header class="site-header">
        <div class="site-title-block">
          <a class="wordmark" href="/">{{ site.name }}</a>
          <p class="site-subtitle">{{ site.title }}</p>
        </div>
      </header>
      {% if page.url != "/" %}
      <main>
        {{ content | safe }}
      </main>
      {% endif %}
    </div>
    <script src="/js/landscape-bg.js"></script>
  </body>
</html>
