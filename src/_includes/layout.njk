<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% if title and title != "Home" %}{{ title }} · {% endif %}{{ site.name }}</title>
    <meta name="description" content="{{ description or site.description }}" />
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body class="{% if page.url == "/" %}home{% else %}reading{% endif %} rick-site">
    <canvas id="rick-bg" aria-hidden="true"></canvas>
    <div class="citadel-banner" role="banner">
      <div class="citadel-skyline" aria-hidden="true"></div>
      <div class="citadel-inner">
        <p class="citadel-badge">Citadel of Ricks</p>
        <p class="citadel-sub">Bureau of Interdimensional Graduate Studies · Sector C-137</p>
      </div>
    </div>
    <div class="page">
      <header class="site-header">
        <a class="wordmark" href="/">{{ site.name }}</a>
        <nav>
          <a href="/#research">Research</a>
          <a href="/#agents">Agents</a>
          <a href="/#education">Credentials</a>
          <a href="/writing/"{% if "/writing/" in page.url %} aria-current="page"{% endif %}>Lab log</a>
          <a href="/notes/"{% if "/notes/" in page.url %} aria-current="page"{% endif %}>Field notes</a>
        </nav>
      </header>
      <main>
        {{ content | safe }}
      </main>
      <footer class="site-footer">
        <p>C-137 · Autonomous agents running in background · Wubba lubba dub dub · <button type="button" class="pickle-hint" id="pickle-trigger" aria-label="Pickle Rick easter egg">🥒</button></p>
      </footer>
    </div>
    <div class="pickle-toast" id="pickle-toast" hidden>I'M PICKLE RICK!</div>
    <script src="/js/rick-bg.js"></script>
    <script src="/js/rick-ui.js"></script>
  </body>
</html>
