<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% if title and title != "Home" %}{{ title }} · {% endif %}{{ site.name }}</title>
    <meta name="description" content="{{ description or site.description }}" />
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body class="{% if page.url == "/" %}home{% else %}reading{% endif %}">
    <canvas id="landscape-bg" aria-hidden="true"></canvas>
    <div class="page">
      <header class="site-header">
        <a class="wordmark" href="/">{{ site.name }}</a>
        <nav>
          <a href="/#education">Education</a>
          <a href="/writing/"{% if "/writing/" in page.url %} aria-current="page"{% endif %}>Writing</a>
          <a href="/notes/"{% if "/notes/" in page.url %} aria-current="page"{% endif %}>Notes</a>
          <a href="https://github.com/{{ site.github }}">GitHub</a>
        </nav>
      </header>
      <main>
        {{ content | safe }}
      </main>
      <footer class="site-footer">
        <p>Local preview · will publish later as {{ site.github }}.github.io</p>
      </footer>
    </div>
    <script src="/js/landscape-bg.js"></script>
  </body>
</html>
