---
layout: layout.njk
title: Home
---

<section class="hero">
  <div class="hero-copy">
    <p class="kicker">Computer Science</p>
    <h1>{{ site.name }}</h1>
    <p class="lede">{{ site.title }} · University of Maryland, Baltimore County</p>
    <p>Projects, writing, and notes on machine learning, optimization, and software. This site is a public notebook — selected work, blog posts, and short references.</p>
    <p class="hero-links">
      <a href="/#research">Research</a>
      <a href="/#agents">Agents</a>
      <a href="/#education">Education</a>
      <a href="/writing/">Writing</a>
      <a href="/notes/">Notes</a>
      <a href="https://github.com/{{ site.github }}">GitHub</a>
    </p>
  </div>
</section>

<section class="rick-panel" id="agents">
  <h2>Agent-based optimization</h2>
  <p>The background is a morphing loss landscape with heat colors and a slow orthographic camera tour. Twenty-four agents run gradient descent on the surface.</p>

  <ul class="tag-list">
    <li>Multi-agent SGD</li>
    <li>Non-convex optimization</li>
    <li>Loss landscape analysis</li>
    <li>Deep learning</li>
  </ul>
</section>

<section class="split boards" id="research">
  <div>
    <h2>Selected research</h2>
    <ul class="cards">
      {% for project in projects %}
      <li>
        <a class="card-media" href="{{ project.url }}">
          <span class="canvas canvas--card">
            <img src="{{ project.image }}" alt="">
          </span>
        </a>
        <a class="card-title" href="{{ project.url }}">{{ project.name }}</a>
        <p>{{ project.blurb }}</p>
      </li>
      {% endfor %}
    </ul>
  </div>

  <div>
    <h2>Recent writing</h2>
    {% if collections.posts.length %}
    <ul class="item-list">
      {% for post in collections.posts.slice(0, 5) %}
      <li>
        <span class="meta">{{ post.date | readableDate }}</span>
        <a href="{{ post.url }}">{{ post.data.title }}</a>
      </li>
      {% endfor %}
    </ul>
    {% else %}
    <p class="empty">No posts yet.</p>
    {% endif %}

    <h2>Notes</h2>
    {% if collections.notes.length %}
    <ul class="item-list">
      {% for note in collections.notes %}
      <li>
        <span class="meta">Note</span>
        <a href="{{ note.url }}">{{ note.data.title }}</a>
      </li>
      {% endfor %}
    </ul>
    {% else %}
    <p class="empty">No notes yet.</p>
    {% endif %}
  </div>
</section>

<section class="education" id="education">
  <h2>Education</h2>
  <ul class="item-list education-list">
    {% for item in education %}
    <li>
      <span class="meta">{% if item.years %}{{ item.years }}{% else %}—{% endif %}</span>
      <div>
        <span class="school">{{ item.school }}</span>
        {% if item.degree %}<p>{{ item.degree }}</p>{% endif %}
        {% if item.detail %}<p>{{ item.detail }}</p>{% endif %}
      </div>
    </li>
    {% endfor %}
  </ul>
</section>
